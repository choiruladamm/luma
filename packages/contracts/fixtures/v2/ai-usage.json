{
  "request": {
    "method": "GET",
    "path": "/v2/ai/usage",
    "headers": {
      "authorization": "Bearer <token>"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "daily_limit_usd": 0.02,
      "remaining_usd": 0.015,
      "used_today_usd": 0.005,
      "resets_at": "<iso>"
    }
  }
}
