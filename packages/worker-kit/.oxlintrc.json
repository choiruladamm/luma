{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.base.json"],
  "ignorePatterns": ["coverage"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/backend/**", "**/dashboard/**", "**/apps/**", "@luma/**"],
            "message": "The worker kit is domain-free: it imports no Worker and no other @luma package (docs/workers.md, Shared code)."
          }
        ]
      }
    ]
  }
}
