{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Config files import local .ts files with the extension (Vite native config loader).
    "allowImportingTsExtensions": true,
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "worker",
    "test/unit",
    "test/integration",
    "test/helpers",
    "test/setup.ts",
    "test/env.d.ts",
    "worker-configuration.d.ts",
    "vitest.config.ts",
    "vite.config.ts",
    "backend-vars.ts"
  ]
}
