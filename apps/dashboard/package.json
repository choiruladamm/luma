{
  "name": "luma-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings && prettier --check .",
    "format": "prettier --write . && oxlint --type-aware --fix",
    "dev": "CLOUDFLARE_ENV=dev vite dev",
    "build": "vite build",
    "types": "wrangler types --env dev --strict-vars false",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
