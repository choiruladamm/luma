<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: gak ada yang ikut cloud backup / device transfer. Data Luma
     dibackup lewat fitur backup sendiri; prefs terenkripsi gak boleh pindah
     HP tanpa master key-nya. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
