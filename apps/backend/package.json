{
  "name": "luma-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings && prettier --check .",
    "format": "prettier --write . && oxlint --type-aware --fix",
    "dev": "wrangler dev --env dev",
    "types": "wrangler types --env dev --strict-vars false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "size": "wrangler deploy --env dev --dry-run --outdir dist"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@luma/core": "workspace:*",
    "@luma/worker-kit": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@msw/cloudflare": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "jose": "6.2.17",
    "msw": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
