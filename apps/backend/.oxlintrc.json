{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.base.json"],
  "ignorePatterns": ["worker-configuration.d.ts", "dist", "coverage", ".wrangler"],
  "overrides": [
    {
      "files": ["test/**"],
      "rules": {
        "vitest/expect-expect": [
          "error",
          {
            "assertFunctionNames": ["expect", "expectContract"]
          }
        ]
      }
    }
  ],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/dashboard/**", "**/apps/**"],
            "message": "A Worker never imports another Worker's code; move shared code to packages/* (docs/workers.md, Shared code)."
          }
        ]
      }
    ]
  }
}
