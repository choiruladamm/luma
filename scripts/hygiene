#!/usr/bin/env sh
# Docs, comment, and lint checks: the single entry for the pre-commit hook, CI, and manual runs.
# Usage: scripts/hygiene [--staged]. HYGIENE_MODE=report prints findings without failing.
# --staged narrows only the docs and comment checks; the linters always run on the whole app.
set -eu
cd "$(git rev-parse --show-toplevel)"

# FVM pins the Flutter SDK locally; CI installs the same version without it.
if command -v fvm >/dev/null 2>&1; then dart="fvm dart"; else dart="dart"; fi

status=0

# Without node_modules the lint script fails with "command not found"; say what to run instead.
need_node_modules() {
  [ -d "$1/node_modules" ] && return 0
  echo "hygiene: $1 has no node_modules; run make backend-install dashboard-install" >&2
  return 1
}

python3 scripts/hygiene_check.py "$@" || status=1

# The dashboard imports backend db code, and its tsconfig points both apps' drizzle-orm types at
# its own copy, so tsc can't see a version skew; compare what each lockfile resolved instead.
drizzle() { grep -o '"drizzle-orm@[^"]*"' "apps/$1/bun.lock" | head -1; }
if [ "$(drizzle backend)" != "$(drizzle dashboard)" ]; then
  echo "hygiene: drizzle-orm differs: backend $(drizzle backend), dashboard $(drizzle dashboard); keep both apps on one version" >&2
  status=1
fi
(cd apps/mobile && $dart analyze --fatal-infos) || status=1
{ need_node_modules apps/backend && (cd apps/backend && bun run lint); } || status=1
{ need_node_modules apps/dashboard && (cd apps/dashboard && bun run lint); } || status=1

if [ "${HYGIENE_MODE:-enforce}" = "report" ]; then
  exit 0
fi
exit "$status"
