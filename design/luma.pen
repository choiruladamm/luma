              "fontFamily": "$fontRead",
              "fontSize": 18.5,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "PajGb",
              "name": "Paragraf kedua",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "And thus you will more safely go about this action if you say to yourself, “I will now go bathe, and keep my own mind in a state conformable to nature.”",
              "lineHeight": 1.65,
              "fontFamily": "$fontRead",
              "fontSize": 18.5,
              "fontWeight": "normal"
            }
